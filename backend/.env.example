# Savora Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=8000

# Supabase PostgreSQL Database
# Get these from: Supabase Dashboard → Settings → Database
DB_HOST=db.xxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-supabase-database-password
DB_NAME=postgres

# Supabase Storage (for image uploads)
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...VCJ9...
SUPABASE_BUCKET_NAME=savora_img

# Xendit Payment Gateway
# Get from: Xendit Dashboard → Settings → API Keys
XENDIT_SECRET_KEY=xnd_development_your_secret_key_here
XENDIT_CALLBACK_TOKEN=your_webhook_verification_token_here

# Optional: Xendit Webhook URL (for development testing)
# XENDIT_WEBHOOK_URL=https://your-ngrok-url.ngrok.io/api/webhook/xendit
