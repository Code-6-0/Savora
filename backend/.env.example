# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3001

# Database Configuration (choose ONE method)
# Method 1: DATABASE_URL (recommended for Supabase/managed Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Method 2: Individual DB variables (alternative)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_NAME=savora

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=savora-secret-key-change-in-production

# Midtrans Configuration (Sandbox)
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://savora-frontend.vercel.app
