# Savora Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Use mock/dummy data when backend is unavailable (true/false)
# Set to "false" for production to show real error states
NEXT_PUBLIC_USE_MOCK=false

# Supabase Client Configuration (if using Supabase Auth)
# Get from: Supabase Dashboard → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Xendit Public Key (for client-side validation, if needed)
# NEXT_PUBLIC_XENDIT_PUBLIC_KEY=xnd_public_key_here
